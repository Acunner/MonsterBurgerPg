Options -Indexes
DirectoryIndex index.php index.html

RewriteEngine On

# Cache longo para assets com ?v=
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff2|woff)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# index.php nunca cacheado
<FilesMatch "^index\.php$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </IfModule>
</FilesMatch>

# Redireciona index.html → index.php
RewriteCond %{THE_REQUEST} /index\.html[\s?]
RewriteRule ^index\.html$ /index.php [R=301,L]

# NÃO intercepta a pasta admin/ nem a pasta api/
RewriteRule ^admin(/.*)?$ - [L]
RewriteRule ^api(/.*)?$   - [L]

# Arquivos e pastas reais passam direto
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo o resto vai para index.php
RewriteRule ^ index.php [QSA,L]
